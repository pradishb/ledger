{
  "name": "ledger",
  "compatibility_date": "2026-09-26",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "ledger.pradish.com.np", "custom_domain": true }]
}
